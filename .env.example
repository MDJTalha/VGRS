VGRS_ENV=development
VGRS_MODE=analysis-only
VGRS_MAX_UPLOAD_MB=25
VGRS_MAX_BATCH_MB=100
VGRS_MAX_DURATION_SECONDS=120
VGRS_MIN_DURATION_SECONDS=2
VGRS_MAX_CONCURRENT_ANALYSES=2
VGRS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VGRS_TRUSTED_HOSTS=

# Default is safe, model-free acoustic analysis.
VGRS_CLASSIFIER_BACKEND=none
VGRS_CLASSIFIER_MODEL_DIR=
VGRS_ENABLE_NONCOMMERCIAL_CLASSIFIER=false

# Production only: configure these only after reviewing a real reverse proxy and its network rules.
VGRS_AUTH_MODE=
VGRS_PROXY_AUTH_ACK=false
VGRS_PROXY_NETWORK_ISOLATED=false
VGRS_PROXY_RATE_LIMIT_ACK=false
VGRS_CLASSIFIER_PLUGIN=
VGRS_CLASSIFIER_LICENSE_APPROVED=false
VGRS_CLASSIFIER_VALIDATION_REPORT=
